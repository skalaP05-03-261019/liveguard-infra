# PostgreSQL
POSTGRES_DB=liveguard
POSTGRES_USER=liveguard
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

# Backend / Business MCP internal authentication
INTERNAL_SERVICE_TOKEN=change-me-internal-local-only

# Agent -> Business MCP
BUSINESS_MCP_AGENT_TOKEN=change-me-business-local-only

# Agent -> RAG MCP
RAG_MCP_AGENT_TOKEN=change-me-rag-local-only

# Backend -> Agent task API
AGENT_SERVICE_TOKEN=change-me-agent-local-only

# RAG database and OpenAI embeddings
# Use a PostgreSQL URL with URL-encoded password.
RAG_DB_URL=
OPENAI_API_KEY=

# LangGraph PostgreSQL checkpoint storage
# Example: postgresql://liveguard:CHANGE_ME@db:5432/liveguard
AGENT_CHECKPOINT_DB_URL=
