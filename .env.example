# PostgreSQL
POSTGRES_DB=liveguard
POSTGRES_USER=liveguard
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

# Backend / Business MCP internal authentication
INTERNAL_SERVICE_TOKEN=change-me-internal-local-only

# Agent -> Business MCP
BUSINESS_MCP_AGENT_TOKEN=change-me-business-local-only

# Agent -> RAG MCP
RAG_MCP_AGENT_TOKEN=change-me-rag-local-only

# Backend -> Agent task API
AGENT_SERVICE_TOKEN=change-me-agent-local-only

# RAG database and OpenAI embeddings
# Use a PostgreSQL URL with URL-encoded password.
RAG_DB_URL=
OPENAI_API_KEY=

# LangGraph PostgreSQL checkpoint storage
# Example: postgresql://liveguard:CHANGE_ME@db:5432/liveguard
AGENT_CHECKPOINT_DB_URL=

# Explicit v1 integration (enable only with matching BE/Agent/RAG and reviewed policies)
LIVEGUARD_POLICY_VERSION=
LIVEGUARD_TBD_FIXTURE_ENABLED=false
LIVEGUARD_V1_UI=false
AGENT_DELIVERY_ENABLED=false
AGENT_GATEWAY_FACTORY=
MODEL_PROVIDER=openai
MODEL_NAME=
FRONTEND_PORT=3000
BACKEND_PORT=8080
AGENT_PORT=8001

# Dedicated compose setting avoids inherited OPENAI_API_KEY overriding the local file.
LIVEGUARD_OPENAI_API_KEY=

# Optional --profile rabbit; DB remains the task authority.
AGENT_DELIVERY_TRANSPORT=db
RABBITMQ_USER=liveguard
RABBITMQ_PASSWORD=

# Business MCP cluster: build once from the verified Agent commit, reuse both instances.
# Verified source: 764eab26a8272d72fc79bcad5b6e7aa82ef8d8b0
BUSINESS_MCP_IMAGE=liveguard-business-mcp:764eab26a827
HAPROXY_IMAGE=haproxy:3.0.30-alpine@sha256:cf3af0facf7eb22b9fee463daf0fbc07ead740b8150696dce724264faf7b4318
AGENT_BUILD_CONTEXT=../liveguard-agent
BACKEND_BUILD_CONTEXT=../liveguard-be
FRONTEND_BUILD_CONTEXT=../liveguard-fe
BUSINESS_MCP_MAX_REQUESTS=16
BUSINESS_MCP_BACKEND_CONNECTIONS=16
BUSINESS_MCP_BACKEND_TIMEOUT=10
BUSINESS_MCP_SHUTDOWN_TIMEOUT=20
BUSINESS_MCP_CLIENT_CONCURRENCY=8
BUSINESS_MCP_CALL_TIMEOUT=10
